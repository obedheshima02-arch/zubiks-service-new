# Configuration ZUBIKS SERVICE - Variables d'environnement
PORT=3000

# Clé secrète pour le hachage des jetons JWT d'authentification
JWT_SECRET=ZUBIX_SERVICE_SECURE_JWT_SECRET_2026_KEY_PROD

# URL de connexion à la base de données Cloud PostgreSQL (Supabase / Neon / Render / Vercel Postgres)
# Exemple Supabase: postgres://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Exemple Neon: postgresql://user:password@ep-cool-name-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
