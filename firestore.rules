rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── MEMBRES ──────────────────────────────────────────────
    // Un utilisateur peut lire/écrire son propre document.
    // L'admin peut lire/écrire tous les documents.
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == memberId ||
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin_second'
      );
    }

    // ── TRANSACTIONS ─────────────────────────────────────────
    // Lecture : tout utilisateur connecté.
    // Écriture : admin ou admin_second uniquement.
    match /transactions/{txId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin_second'
      );
    }

    // ── MESSAGES ─────────────────────────────────────────────
    // Lecture : tout utilisateur connecté.
    // Écriture : utilisateur connecté (peut envoyer ses propres messages).
    match /messages/{msgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── STATS GLOBALES ───────────────────────────────────────
    // Lecture : tout utilisateur connecté.
    // Écriture : admin uniquement.
    match /global_stats/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin_second'
      );
    }

    // ── ARCHIVES ─────────────────────────────────────────────
    match /archives/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /daily_archives/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin_second'
      );
    }
  }
}
